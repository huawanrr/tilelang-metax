
import torch
import tilelang
import tilelang.language as T


@tilelang.jit(
    pass_configs={
        tilelang.PassConfigKey.TL_ENABLE_FAST_MATH: True,
        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
    },
)
def native_sparse_attention_single_block(
    batch,
    heads,
    seq_len,
    dim,
    is_causal,
    block_size,
    groups,
    scale_log2,
    threads=64,
    kv_reuse=True,
    stage_regs=True,
    o_stage=False,
    q_frag=False,
    nmax=False,
    kv_frag=False,
):

    head_kv = heads // groups
    q_shape = [batch, seq_len, heads, dim]
    kv_shape = [batch, seq_len, head_kv, dim]
    block_indices_shape = [batch, seq_len, head_kv, 1]

    dtype = T.float16
    accum_dtype = T.float32
    block_t = min(128, tilelang.math.next_power_of_2(dim))

    assert tilelang.cdiv(dim, block_t) == 1, (
        "The key dimension can not be larger than 128"
    )

    G = groups
    BS = block_size
    BK = BV = block_t

    @T.prim_func
    def kernel(
        Q: T.Tensor(q_shape, dtype),
        K: T.Tensor(kv_shape, dtype),
        V: T.Tensor(kv_shape, dtype),
        BlockIndices: T.Tensor(block_indices_shape, T.int32),
        Output: T.Tensor(q_shape, dtype),
    ):
        with T.Kernel(
            seq_len,
            tilelang.cdiv(dim, BV),
            batch * head_kv,
            threads=threads,
        ) as (bx, by, bz):
            if kv_frag or q_frag:
                Q_reg = T.alloc_fragment([G, BK], dtype)
            else:
                Q_shared = T.alloc_shared([G, BK], dtype)
            if kv_frag:
                K_reg = T.alloc_fragment([BS, BK], dtype)
                V_reg = T.alloc_fragment([BS, BV], dtype)
            elif kv_reuse:
                KV_shared = T.alloc_shared([BS, BK], dtype)
            else:
                K_shared = T.alloc_shared([BS, BK], dtype)
                V_shared = T.alloc_shared([BS, BV], dtype)

            acc_s = T.alloc_fragment([G, BS], accum_dtype)
            acc_s_cast = T.alloc_fragment([G, BS], dtype)
            acc_o = T.alloc_fragment([G, BV], accum_dtype)
            if not nmax:
                scores_max = T.alloc_fragment([G], accum_dtype)
            scores_sum = T.alloc_fragment([G], accum_dtype)
            scores_inv_sum = T.alloc_fragment([G], accum_dtype)

            i_t = bx
            i_v = by
            i_bh = bz
            i_b = i_bh // head_kv
            i_h = i_bh % head_kv
            i_s = BlockIndices[i_b, i_t, i_h, 0] * BS

            T.fill(acc_o, 0)
            T.fill(scores_sum, 0)

            if (
                i_s >= 0
                and i_s < seq_len
                and (not is_causal or i_s <= i_t)
            ):
                if kv_frag:
                    T.copy(
                        Q[i_b, i_t, i_h * G : (i_h + 1) * G, :],
                        Q_reg,
                    )
                    T.copy(K[i_b, i_s : i_s + BS, i_h, :], K_reg)
                    T.copy(
                        V[i_b, i_s : i_s + BS, i_h, i_v * BV : (i_v + 1) * BV],
                        V_reg,
                    )
                elif stage_regs:
                    if not q_frag:
                        Q_reg = T.alloc_fragment([G, BK], dtype)
                    K_reg = T.alloc_fragment([BS, BK], dtype)
                    V_reg = T.alloc_fragment([BS, BV], dtype)
                    T.copy(
                        Q[i_b, i_t, i_h * G : (i_h + 1) * G, :],
                        Q_reg,
                    )
                    T.copy(K[i_b, i_s : i_s + BS, i_h, :], K_reg)
                    T.copy(
                        V[i_b, i_s : i_s + BS, i_h, i_v * BV : (i_v + 1) * BV],
                        V_reg,
                    )
                    if not q_frag:
                        T.copy(Q_reg, Q_shared)
                    if kv_reuse:
                        T.copy(K_reg, KV_shared)
                    else:
                        T.copy(K_reg, K_shared)
                        T.copy(V_reg, V_shared)
                else:
                    if q_frag:
                        T.copy(
                            Q[i_b, i_t, i_h * G : (i_h + 1) * G, :],
                            Q_reg,
                        )
                    else:
                        T.copy(
                            Q[i_b, i_t, i_h * G : (i_h + 1) * G, :],
                            Q_shared,
                        )
                    if not kv_reuse:
                        T.copy(K[i_b, i_s : i_s + BS, i_h, :], K_shared)
                        T.copy(
                            V[
                                i_b,
                                i_s : i_s + BS,
                                i_h,
                                i_v * BV : (i_v + 1) * BV,
                            ],
                            V_shared,
                        )
                    else:
                        T.copy(K[i_b, i_s : i_s + BS, i_h, :], KV_shared)

                if is_causal:
                    if i_s + BS <= i_t + 1:
                        T.clear(acc_s)
                    else:
                        for i, j in T.Parallel(G, BS):
                            acc_s[i, j] = T.if_then_else(
                                i_s + j <= i_t,
                                0,
                                -T.infinity(accum_dtype),
                            )
                elif i_s + BS <= seq_len:
                    T.clear(acc_s)
                else:
                    for i, j in T.Parallel(G, BS):
                        acc_s[i, j] = T.if_then_else(
                            i_s + j < seq_len,
                            0,
                            -T.infinity(accum_dtype),
                        )

                q_a = Q_reg if (kv_frag or q_frag) else Q_shared
                if kv_frag:
                    T.gemm(
                        q_a,
                        K_reg,
                        acc_s,
                        transpose_B=True,
                        policy=T.GemmWarpPolicy.FullRow,
                    )
                elif kv_reuse:
                    T.gemm(
                        q_a,
                        KV_shared,
                        acc_s,
                        transpose_B=True,
                        policy=T.GemmWarpPolicy.FullRow,
                    )
                else:
                    T.gemm(
                        q_a,
                        K_shared,
                        acc_s,
                        transpose_B=True,
                        policy=T.GemmWarpPolicy.FullRow,
                    )

                if nmax:
                    for i, j in T.Parallel(G, BS):
                        acc_s[i, j] = T.exp2(
                            T.min(acc_s[i, j] * scale_log2, 15.0)
                        )
                else:
                    T.fill(scores_max, -T.infinity(accum_dtype))
                    T.reduce_max(acc_s, scores_max, dim=1, clear=True)
                    for i, j in T.Parallel(G, BS):
                        acc_s[i, j] = T.exp2(
                            (acc_s[i, j] - scores_max[i]) * scale_log2
                        )
                T.reduce_sum(acc_s, scores_sum, dim=1, clear=True)

                for i in T.Parallel(G):
                    scores_inv_sum[i] = T.if_then_else(
                        scores_sum[i] > 0,
                        1.0 / scores_sum[i],
                        0.0,
                    )
                for i, j in T.Parallel(G, BS):
                    acc_s[i, j] *= scores_inv_sum[i]
                T.copy(acc_s, acc_s_cast)

                if kv_frag:
                    T.gemm(
                        acc_s_cast,
                        V_reg,
                        acc_o,
                        policy=T.GemmWarpPolicy.FullRow,
                    )
                elif kv_reuse:
                    if stage_regs:
                        T.copy(V_reg, KV_shared)
                    else:
                        T.copy(
                            V[
                                i_b,
                                i_s : i_s + BS,
                                i_h,
                                i_v * BV : (i_v + 1) * BV,
                            ],
                            KV_shared,
                        )
                    T.gemm(
                        acc_s_cast,
                        KV_shared,
                        acc_o,
                        policy=T.GemmWarpPolicy.FullRow,
                    )
                else:
                    T.gemm(
                        acc_s_cast,
                        V_shared,
                        acc_o,
                        policy=T.GemmWarpPolicy.FullRow,
                    )

            if o_stage:
                O_shared = T.alloc_shared([G, BV], dtype)
                T.copy(acc_o, O_shared)
                T.copy(
                    O_shared,
                    Output[
                        i_b,
                        i_t,
                        i_h * G : (i_h + 1) * G,
                        i_v * BV : (i_v + 1) * BV,
                    ],
                )
            else:
                T.copy(
                    acc_o,
                    Output[
                        i_b,
                        i_t,
                        i_h * G : (i_h + 1) * G,
                        i_v * BV : (i_v + 1) * BV,
                    ],
                )

    return kernel


@tilelang.jit(
    pass_configs={
        tilelang.PassConfigKey.TL_ENABLE_FAST_MATH: True,
        tilelang.PassConfigKey.TL_DISABLE_WARP_SPECIALIZED: True,
    },
)
def native_sparse_attention_online(
    batch,
    heads,
    seq_len,
    dim,
    is_causal,
    block_size,
    groups,
    selected_blocks,
    scale_log2,
    threads=64,
    num_stages=1,
    o_stage=False,
    stage_regs=True,
    nmax=False,
    kv_frag=False,
):

    head_kv = heads // groups
    q_shape = [batch, seq_len, heads, dim]
    kv_shape = [batch, seq_len, head_kv, dim]
    block_indices_shape = [batch, seq_len, head_kv, selected_blocks]

    dtype = T.float16
    accum_dtype = T.float32
    block_t = min(128, tilelang.math.next_power_of_2(dim))

    assert tilelang.cdiv(dim, block_t) == 1, (
        "The key dimension can not be larger than 128"
    )

    S = selected_blocks
    G = groups
    BS = block_size
    BK = BV = block_t

    @T.prim_func
    def kernel(
        Q: T.Tensor(q_shape, dtype),
        K: T.Tensor(kv_shape, dtype),
        V: T.Tensor(kv_shape, dtype),
        BlockIndices: T.Tensor(block_indices_shape, T.int32),
        Output: T.Tensor(q_shape, dtype),
    ):
        with T.Kernel(
            seq_len,
            tilelang.cdiv(dim, BV),
            batch * head_kv,
            threads=threads,
        ) as (bx, by, bz):
            Q_shared = T.alloc_shared([G, BK], dtype)
            if kv_frag:
                K_reg = T.alloc_fragment([BS, BK], dtype)
                V_reg = T.alloc_fragment([BS, BV], dtype)
            else:
                K_shared = T.alloc_shared([BS, BK], dtype)
                V_shared = T.alloc_shared([BS, BV], dtype)

            acc_s = T.alloc_fragment([G, BS], accum_dtype)
            acc_s_cast = T.alloc_fragment([G, BS], dtype)
            acc_o = T.alloc_fragment([G, BV], accum_dtype)
            if not nmax:
                scores_max = T.alloc_fragment([G], accum_dtype)
                scores_max_prev = T.alloc_fragment([G], accum_dtype)
                scores_scale = T.alloc_fragment([G], accum_dtype)
            scores_sum = T.alloc_fragment([G], accum_dtype)
            scores_inv_sum = T.alloc_fragment([G], accum_dtype)
            logsum = T.alloc_fragment([G], accum_dtype)

            i_t = bx
            i_v = by
            i_bh = bz
            i_b = i_bh // head_kv
            i_h = i_bh % head_kv

            T.copy(
                Q[i_b, i_t, i_h * G : (i_h + 1) * G, :],
                Q_shared,
            )
            T.fill(acc_o, 0)
            if nmax:
                sum_acc = T.alloc_fragment([G, BS], accum_dtype)
                T.fill(sum_acc, 0)
            else:
                T.fill(logsum, 0)
                T.fill(scores_max, -T.infinity(accum_dtype))

            if stage_regs:
                if not kv_frag:
                    K_reg = T.alloc_fragment([BS, BK], dtype)
                    V_reg = T.alloc_fragment([BS, BV], dtype)

                for s in T.serial(S):
                    i_s = BlockIndices[i_b, i_t, i_h, s] * BS
                    if (
                        i_s >= 0
                        and i_s < seq_len
                        and (not is_causal or i_s <= i_t)
                    ):
                        T.copy(K[i_b, i_s : i_s + BS, i_h, :], K_reg)
                        T.copy(
                            V[i_b, i_s : i_s + BS, i_h, i_v * BV : (i_v + 1) * BV],
                            V_reg,
                        )
                        if not kv_frag:
                            T.copy(K_reg, K_shared)

                        if is_causal:
                            if i_s + BS <= i_t + 1:
                                T.clear(acc_s)
                            else:
                                for i, j in T.Parallel(G, BS):
                                    acc_s[i, j] = T.if_then_else(
                                        i_s + j <= i_t,
                                        0,
                                        -T.infinity(accum_dtype),
                                    )
                        elif i_s + BS <= seq_len:
                            T.clear(acc_s)
                        else:
                            for i, j in T.Parallel(G, BS):
                                acc_s[i, j] = T.if_then_else(
                                    i_s + j < seq_len,
                                    0,
                                    -T.infinity(accum_dtype),
                                )

                        T.gemm(
                            Q_shared,
                            K_reg if kv_frag else K_shared,
                            acc_s,
                            transpose_B=True,
                            policy=T.GemmWarpPolicy.FullRow,
                        )

                        if nmax:
                            for i, j in T.Parallel(G, BS):
                                acc_s[i, j] = T.exp2(
                                    T.min(acc_s[i, j] * scale_log2, 15.0)
                                )
                            for i, j in T.Parallel(G, BS):
                                sum_acc[i, j] += acc_s[i, j]
                            T.copy(acc_s, acc_s_cast)
                        else:
                            T.copy(scores_max, scores_max_prev)
                            T.fill(scores_max, -T.infinity(accum_dtype))
                            T.reduce_max(
                                acc_s,
                                scores_max,
                                dim=1,
                                clear=True,
                            )
                            for i in T.Parallel(G):
                                scores_max[i] = T.max(
                                    scores_max_prev[i],
                                    scores_max[i],
                                )
                                scores_scale[i] = T.exp2(
                                    (scores_max_prev[i] - scores_max[i])
                                    * scale_log2
                                )
                            for i, j in T.Parallel(G, BS):
                                acc_s[i, j] = T.exp2(
                                    (acc_s[i, j] - scores_max[i]) * scale_log2
                                )
                            T.reduce_sum(acc_s, scores_sum, dim=1, clear=True)
                            for i in T.Parallel(G):
                                logsum[i] = (
                                    logsum[i] * scores_scale[i] + scores_sum[i]
                                )
                            T.copy(acc_s, acc_s_cast)
                            for i, j in T.Parallel(G, BV):
                                acc_o[i, j] *= scores_scale[i]

                        if not kv_frag:
                            T.copy(V_reg, V_shared)
                        T.gemm(
                            acc_s_cast,
                            V_reg if kv_frag else V_shared,
                            acc_o,
                            policy=T.GemmWarpPolicy.FullRow,
                        )
            else:
                for s in T.Pipelined(S, num_stages=num_stages):
                    i_s = BlockIndices[i_b, i_t, i_h, s] * BS

                    if (
                        i_s >= 0
                        and i_s < seq_len
                        and (not is_causal or i_s <= i_t)
                    ):
                        T.copy(
                            K[i_b, i_s : i_s + BS, i_h, :],
                            K_shared,
                        )

                        if is_causal:
                            if i_s + BS <= i_t + 1:
                                T.clear(acc_s)
                            else:
                                for i, j in T.Parallel(G, BS):
                                    acc_s[i, j] = T.if_then_else(
                                        i_s + j <= i_t,
                                        0,
                                        -T.infinity(accum_dtype),
                                    )
                        elif i_s + BS <= seq_len:
                            T.clear(acc_s)
                        else:
                            for i, j in T.Parallel(G, BS):
                                acc_s[i, j] = T.if_then_else(
                                    i_s + j < seq_len,
                                    0,
                                    -T.infinity(accum_dtype),
                                )

                        T.gemm(
                            Q_shared,
                            K_shared,
                            acc_s,
                            transpose_B=True,
                            policy=T.GemmWarpPolicy.FullRow,
                        )

                        if nmax:
                            for i, j in T.Parallel(G, BS):
                                acc_s[i, j] = T.exp2(
                                    T.min(acc_s[i, j] * scale_log2, 15.0)
                                )
                            for i, j in T.Parallel(G, BS):
                                sum_acc[i, j] += acc_s[i, j]
                            T.copy(acc_s, acc_s_cast)
                        else:
                            T.copy(scores_max, scores_max_prev)
                            T.fill(scores_max, -T.infinity(accum_dtype))
                            T.reduce_max(
                                acc_s,
                                scores_max,
                                dim=1,
                                clear=True,
                            )
                            for i in T.Parallel(G):
                                scores_max[i] = T.max(
                                    scores_max_prev[i],
                                    scores_max[i],
                                )
                                scores_scale[i] = T.exp2(
                                    (scores_max_prev[i] - scores_max[i])
                                    * scale_log2
                                )
                            for i, j in T.Parallel(G, BS):
                                acc_s[i, j] = T.exp2(
                                    (acc_s[i, j] - scores_max[i])
                                    * scale_log2
                                )
                            T.reduce_sum(acc_s, scores_sum, dim=1, clear=True)
                            for i in T.Parallel(G):
                                logsum[i] = (
                                    logsum[i] * scores_scale[i] + scores_sum[i]
                                )
                            T.copy(acc_s, acc_s_cast)
                            for i, j in T.Parallel(G, BV):
                                acc_o[i, j] *= scores_scale[i]

                        T.copy(
                            V[
                                i_b,
                                i_s : i_s + BS,
                                i_h,
                                i_v * BV : (i_v + 1) * BV,
                            ],
                            V_shared,
                        )
                        T.gemm(
                            acc_s_cast,
                            V_shared,
                            acc_o,
                            policy=T.GemmWarpPolicy.FullRow,
                        )

            if nmax:
                T.reduce_sum(sum_acc, scores_sum, dim=1, clear=True)
                for i in T.Parallel(G):
                    scores_inv_sum[i] = T.if_then_else(
                        scores_sum[i] > 0,
                        1.0 / scores_sum[i],
                        0.0,
                    )
            else:
                for i in T.Parallel(G):
                    scores_inv_sum[i] = T.if_then_else(
                        logsum[i] > 0,
                        1.0 / logsum[i],
                        0.0,
                    )
            for i, j in T.Parallel(G, BV):
                acc_o[i, j] *= scores_inv_sum[i]

            if o_stage:
                O_shared = T.alloc_shared([G, BV], dtype)
                T.copy(acc_o, O_shared)
                T.copy(
                    O_shared,
                    Output[
                        i_b,
                        i_t,
                        i_h * G : (i_h + 1) * G,
                        i_v * BV : (i_v + 1) * BV,
                    ],
                )
            else:
                T.copy(
                    acc_o,
                    Output[
                        i_b,
                        i_t,
                        i_h * G : (i_h + 1) * G,
                        i_v * BV : (i_v + 1) * BV,
                    ],
                )

    return kernel


_KERNEL_CACHE = {}


def _get_kernel(
    B,
    seq_len,
    H,
    HQ,
    D,
    S,
    block_size,
    is_causal,
    scale=None,
    threads=64,
    num_stages=1,
    kv_reuse=True,
    stage_regs=True,
    o_stage=False,
    q_frag=None,
    nmax=True,
    kv_frag=False,
):
    if q_frag is None:
        q_frag = block_size == 32
    groups = HQ // H
    scale_log2 = (D**-0.5 if scale is None else float(scale)) * 1.44269504
    key = (
        B,
        seq_len,
        H,
        HQ,
        D,
        S,
        block_size,
        int(bool(is_causal)),
        scale_log2,
        threads,
        num_stages,
        kv_reuse,
        stage_regs,
        o_stage,
        q_frag,
        nmax,
        kv_frag,
    )
    kernel = _KERNEL_CACHE.get(key)
    if kernel is None:
        common = dict(
            batch=B,
            heads=HQ,
            seq_len=seq_len,
            dim=D,
            is_causal=bool(is_causal),
            block_size=block_size,
            groups=groups,
            scale_log2=scale_log2,
            threads=threads,
        )
        if S == 1:
            kernel = native_sparse_attention_single_block(
                kv_reuse=kv_reuse,
                stage_regs=stage_regs,
                o_stage=o_stage,
                q_frag=q_frag,
                nmax=nmax,
                kv_frag=kv_frag,
                **common,
            )
        else:
            kernel = native_sparse_attention_online(
                selected_blocks=S,
                num_stages=num_stages,
                o_stage=o_stage,
                stage_regs=stage_regs,
                nmax=nmax,
                kv_frag=kv_frag,
                **common,
            )
        _KERNEL_CACHE[key] = kernel
    return kernel


def _as_int32(tensor):
    if tensor.dtype != torch.int32:
        tensor = tensor.to(torch.int32)
    if not tensor.is_contiguous():
        tensor = tensor.contiguous()
    return tensor


def native_sparse_attention(
    batch,
    heads,
    seq_len,
    dim,
    is_causal,
    scale=None,
    block_size=64,
    groups=1,
    selected_blocks=16,
    threads=64,
    num_stages=1,
    kv_reuse=True,
    stage_regs=True,
    o_stage=False,
    q_frag=None,
    nmax=True,
    kv_frag=False,
):
    if q_frag is None:
        q_frag = block_size == 32
    kernel = _get_kernel(
        batch,
        seq_len,
        heads // groups,
        heads,
        dim,
        selected_blocks,
        block_size,
        is_causal,
        scale,
        threads=threads,
        num_stages=num_stages,
        kv_reuse=kv_reuse,
        stage_regs=stage_regs,
        o_stage=o_stage,
        q_frag=q_frag,
        nmax=nmax,
        kv_frag=kv_frag,
    )

    def run(Q, K, V, BlockIndices):
        output = torch.empty_like(Q)
        kernel(Q, K, V, _as_int32(BlockIndices), output)
        return output

    return run


def run_kernel(
    q,
    k,
    v,
    block_indices,
    output,
    B,
    seq_len,
    H,
    HQ,
    D,
    S,
    block_size,
    is_causal,
    scale=None,
):
    kernel = _get_kernel(
        int(B),
        int(seq_len),
        int(H),
        int(HQ),
        int(D),
        int(S),
        int(block_size),
        bool(is_causal),
        scale,
    )
    kernel(q, k, v, _as_int32(block_indices), output)
